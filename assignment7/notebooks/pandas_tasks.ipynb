    "import pandas as pd\n",
    "\n",
    "data = {\n",
    "    \"Name\": [\"Anna\", \"John\", \"Ali\", \"Maria\", \"Tom\"],\n",
    "    \"Age\": [19, 21, 22, 20, 23],\n",
    "    \"Score\": [78, 85, 90, 88, 70]\n",
